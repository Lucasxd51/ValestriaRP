PitchRange: 0.0 0.7
}
4900-9000{
Sound: tt_int_high
PitchRange: 0.0 0.65
}
}
Exterior{
Starting{
Sound: tt_start
}
0-1500{
Sound: tt_ex_idle
PitchRange: 0.5 2.0
}
1400-5000{
Sound: tt_ex_low
PitchRange: 0.0 0.7
}
4900-9000{
Sound: tt_ex_high
PitchRange: 0.0 0.65
}
}
}
